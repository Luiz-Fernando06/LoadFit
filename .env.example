# Copie este arquivo para .env e substitua pelos dados do seu projeto Supabase.
# Supabase > Project Settings > API (ou Connect)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE
# Se o seu projeto ainda usa uma chave anon antiga, pode usar esta variável no lugar:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
